# ==============================================================================
# Comprehensive .gitignore for Inventory Management System (Spring Boot + React)
# ==============================================================================

# ------------------------------------------------------------------------------
# Maven & Java Build Outputs
# ------------------------------------------------------------------------------
target/
*.class
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven wrapper and log files
.mvn/
mvnw
mvnw.cmd
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------------------------
# Frontend / Node.js (React + Vite)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/

# Local Environment Variables & Secrets
.env.local
.env.*.local
frontend/.env.local
frontend/.env.*.local

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# In-Memory & Embedded Databases
# ------------------------------------------------------------------------------
*.db
*.mv.db
*.trace.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
temp/
tmp/
*.tmp
*.bak
*.swp
*~

# ------------------------------------------------------------------------------
# IDEs & Developer Tools
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
bin/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# AI IDE / Antigravity Scratch Directories
.gemini/
.agents/

# ------------------------------------------------------------------------------
# Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
